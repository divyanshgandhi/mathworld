# Copy to .env.local for local overrides. Leave DATABASE_URL unset to use PGlite in .data/pg.

# Supabase Postgres, transaction pooler (port 6543). Required on Vercel.
DATABASE_URL=

# Optional: Supabase direct or session connection (port 5432) for migrations.
# Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# /admin dashboard passphrase (at least 10 characters). Leave empty and /admin stays off.
MW_ADMIN_KEY=
