# Copy to .env.local for local overrides. Leave these unset to use PGlite in .data/pg.

# On Vercel the easy way is the project's Storage tab: add a Supabase database there and Vercel sets
# POSTGRES_URL and POSTGRES_URL_NON_POOLING by itself. The app reads those when the two below are empty.

# Supabase Postgres, transaction pooler (port 6543).
DATABASE_URL=

# Optional: Supabase session pooler (port 5432) for migrations. Falls back to the address above.
MIGRATION_DATABASE_URL=

# /admin dashboard passphrase (at least 6 characters). Leave empty and /admin stays off.
MW_ADMIN_KEY=

# Optional: the site's own address, for the picture a shared link shows (for example https://mathworld.example).
# On Vercel it is worked out from the project's production host, so leave this empty unless you use a custom domain.
MW_SITE_URL=
